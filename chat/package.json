{
  "name": "panorama-video-maker-chat",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,chat -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:chat\"",
    "dev:api": "cd .. && uv run uvicorn workshop.server.app:app --host 127.0.0.1 --port 8000",
    "dev:chat": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/react": "4.0.147",
    "ai": "7.0.143",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "typescript": "5.9.3"
  }
}
